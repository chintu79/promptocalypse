# LLM Provider: "ollama" (local/LAN), "groq" (cloud), or "openrouter" (cloud)
LLM_PROVIDER=ollama

# Ollama endpoints — comma-separated list of remote PCs running Ollama
# Requests are round-robin'd across all endpoints for load balancing.
# Example with 2 PCs on LAN:
OLLAMA_ENDPOINTS=http://192.168.1.101:11434/v1,http://192.168.1.102:11434/v1
OLLAMA_MODEL=llama3.2:latest

# Groq (cloud) — uncomment and set LLM_PROVIDER=groq to use
# GROQ_API_KEY=gsk_your_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter (cloud) — uncomment and set LLM_PROVIDER=openrouter to use
# OPENROUTER_API_KEY=sk-or-your_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

ADMIN_TOKEN=change_me_to_a_secure_token
